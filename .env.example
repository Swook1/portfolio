# Server-side only — never prefix these with VITE_, or Vite inlines them into
# the browser bundle and the key ships to every visitor.

# InferHub API key (https://inferhub.dev)
INFERHUB_API_KEY=

# Model id to route to, e.g. anthropic/claude-sonnet-5 or openai/gpt-4.1-mini.
# Check the InferHub dashboard for the exact ids your key can reach.
INFERHUB_MODEL=

# Optional. The documented OpenAI-compatible base; only change it if InferHub does.
# INFERHUB_BASE_URL=https://api.inferhub.dev/v1

# Optional, client-side. Point the widget at a backend on another origin.
# Leave unset to use this site's own /api/chat.
# VITE_CHAT_ENDPOINT=
